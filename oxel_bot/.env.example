# Oxel Bot — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit your .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED: Telegram Bot ───────────────────────────────────────────────────
# Get this from @BotFather on Telegram
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# ── REQUIRED: Web Admin Security ─────────────────────────────────────────────
# Generate a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=generate-a-strong-random-key-here

# Strong password for the web admin dashboard. Use a password manager.
ADMIN_PASSWORD=choose-a-strong-admin-password

# ── REQUIRED: Telegram Admin IDs ─────────────────────────────────────────────
# Comma-separated Telegram user IDs that have admin privileges in the bot
# Find your ID by messaging @userinfobot on Telegram
ADMIN_USER_IDS=123456789

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default, good for single-server):
DATABASE_URL=sqlite:///oxel_bot.db
# PostgreSQL (recommended for production):
# DATABASE_URL=postgresql://user:password@localhost:5432/oxel_db

# ── Bot & Shop Info ───────────────────────────────────────────────────────────
BOT_USERNAME=YourBotUsername
SHOP_NAME=YourShopName
SHOP_WEBSITE=https://yourshop.com

# ── Payment Info (shown to customers during checkout) ─────────────────────────
TELEBIRR_NUMBER=09XXXXXXXX (Your Name)
CBE_NUMBER=1000000000000 (Your Name)

# ── Social Links ──────────────────────────────────────────────────────────────
TELEGRAM_CHANNEL=https://t.me/yourchannel
INSTAGRAM_URL=https://instagram.com/yourhandle
TIKTOK_URL=https://tiktok.com/@yourhandle

# ── Rate Limiting (optional, defaults shown) ──────────────────────────────────
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
