# Oxel Bot — Environment Variables Template
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your actual credentials/settings.
# NEVER commit your real .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED: Telegram Bot Configuration ─────────────────────────────────────
# Obtain your Bot Token from @BotFather on Telegram
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Comma-separated Telegram User IDs authorized for bot administration
# Find your numeric User ID by messaging @userinfobot on Telegram
ADMIN_USER_IDS=123456789

# ── Database Configuration ───────────────────────────────────────────────────
# SQLite (default for single-server / local dev):
DATABASE_URL=sqlite:///oxel_bot.db
# PostgreSQL (recommended for production deployment):
# DATABASE_URL=postgresql://user:password@localhost:5432/oxel_db

# ── Store & Branding Information ─────────────────────────────────────────────
BOT_USERNAME=YourBotUsername
SHOP_NAME=Oxel
SHOP_WEBSITE=https://yourshop.com

# ── Payment Information (Shown to customers during checkout) ─────────────────
TELEBIRR_NUMBER=09XXXXXXXX (Account Holder Name)
CBE_NUMBER=1000000000000 (Account Holder Name)

# ── Social & Channel Links ────────────────────────────────────────────────────
TELEGRAM_CHANNEL=https://t.me/yourchannel
INSTAGRAM_URL=https://instagram.com/yourhandle
TIKTOK_URL=https://tiktok.com/@yourhandle
